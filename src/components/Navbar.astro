---
import SocialLinks from "./SocialLinks.astro";
---

<header class="sticky top-0 z-50 border-b border-border/70 bg-background/85 backdrop-blur">
  <div class="mx-auto flex max-w-[960px] items-center justify-between gap-4 px-5 py-3 sm:px-8">
    <a
      href="#top"
      class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent font-mono text-base font-bold text-on-accent transition-transform hover:-rotate-6"
      aria-label="Back to top"
    >
      IT
    </a>

    <SocialLinks iconSize={16} />
  </div>
</header>
