---
import SocialLinks from "./SocialLinks.astro";

const sections = [
  { href: "#about", label: "About" },
  { href: "#help", label: "Help" },
  { href: "#now", label: "Now" },
  { href: "#writing", label: "Writing" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 border-b border-border/70 bg-background/85 backdrop-blur">
  <div class="mx-auto flex max-w-[960px] items-center justify-between gap-4 px-5 py-3 sm:px-8">
    <a
      href="#top"
      class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent font-mono text-base font-bold text-on-accent transition-transform hover:-rotate-6"
      aria-label="Back to top"
    >
      IT
    </a>

    <nav aria-label="Sections" class="hidden items-center gap-5 sm:flex">
      {
        sections.map((section) => (
          <a href={section.href} class="text-base text-secondary transition-colors hover:text-accent">
            {section.label}
          </a>
        ))
      }
    </nav>

    <SocialLinks iconSize={16} />
  </div>
</header>
