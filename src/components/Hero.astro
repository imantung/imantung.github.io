---
import { Image } from "astro:assets";
import { profile, socials } from "../data/content";
import profilePhoto from "../assets/profiles.png";
import Icon from "./Icon.astro";
---

<section id="top" class="relative overflow-hidden">
  <div class="bg-patterns pointer-events-none absolute inset-0" aria-hidden="true">
    <span class="pattern-dots"></span>
    <span class="pattern-graph"></span>
    <span class="pattern-plus"></span>
    <span class="pattern-hatch"></span>
    <span class="pattern-rings"></span>
  </div>

  <div
    class="relative mx-auto grid max-w-[960px] items-center gap-10 px-5 pb-4 pt-14 sm:px-8 sm:pb-8 sm:pt-24 md:grid-cols-[1fr_auto] md:gap-16"
  >
    <div class="enter order-2 flex flex-col items-center text-center md:order-1 md:items-start md:text-left">
      <p
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-background/80 px-3 py-1 text-base text-secondary"
      >
        <span class="pulse-dot h-2 w-2 rounded-full bg-accent"></span>
        {profile.availability}
      </p>
      <h1 class="name-title caret">{profile.name}</h1>
      <p class="headline-text mt-4 max-w-[34ch]">{profile.headline}</p>
      <p class="meta-text mt-3 inline-flex items-center gap-1.5">
        <Icon name="mapPin" size={16} aria-hidden={true} />
        {profile.location}
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={`mailto:${profile.email}`} class="btn btn-primary">
          <Icon name="mail" size={18} class="icon-mail mail-buzz" aria-hidden={true} />
          Get in touch
        </a>
        <a href={socials.linkedin} target="_blank" rel="noopener noreferrer" class="btn">
          <Icon name="linkedin" size={16} aria-hidden={true} />
          LinkedIn
        </a>
      </div>
    </div>

    <div class="enter order-1 justify-self-center md:order-2 md:mr-3">
      <div class="profile-photo relative h-40 w-40 sm:h-52 sm:w-52 md:h-60 md:w-60" data-profile-photo>
        <div class="profile-shadow absolute inset-0 rounded-2xl border-2 border-accent" aria-hidden="true">
        </div>
        <div class="profile-card relative h-full w-full overflow-hidden rounded-2xl border border-border bg-surface">
          <Image
            src={profilePhoto}
            alt={profile.name}
            width={480}
            height={480}
            densities={[1, 2]}
            format="webp"
            quality={80}
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Feed the pointer position (-1..1 on each axis) to the profile photo so
  // it tilts toward the cursor while its shadow slides away like a light.
  const photo = document.querySelector<HTMLElement>("[data-profile-photo]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (photo && !reduceMotion) {
    photo.addEventListener("pointermove", (event) => {
      const rect = photo.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      const y = ((event.clientY - rect.top) / rect.height) * 2 - 1;
      photo.style.setProperty("--px", x.toFixed(3));
      photo.style.setProperty("--py", y.toFixed(3));
    });

    photo.addEventListener("pointerleave", () => {
      photo.style.removeProperty("--px");
      photo.style.removeProperty("--py");
    });

    // Every few seconds, hop to a random pose other than the current one.
    const poses = ["rest", "lean", "lift", "peek", "stretch"];
    let pose = "rest";

    const nextPose = () => {
      const others = poses.filter((p) => p !== pose);
      pose = others[Math.floor(Math.random() * others.length)];
      photo.dataset.pose = pose;
      setTimeout(nextPose, 3000 + Math.random() * 2000);
    };

    setTimeout(nextPose, 3000);
  }
</script>
