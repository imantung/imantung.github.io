---
import { about, profile } from "../data/content";
import Icon from "./Icon.astro";
import SectionHeader from "./SectionHeader.astro";
---

<section id="about" class="py-16 sm:py-20">
  <SectionHeader index="01" label="about" title="About" />

  <div class="flex max-w-[65ch] flex-col gap-4" data-reveal>
    {about.intro.map((paragraph) => <p class="body-text">{paragraph}</p>)}
  </div>

  <h3 class="subsection-title mb-4 mt-12" data-reveal>Where I can help</h3>
  <ul class="grid gap-4 sm:grid-cols-2" data-reveal-stagger>
    {
      about.helpAreas.map((item) => (
        <li class="card flex flex-col gap-3">
          <span class="icon-tile">
            <Icon name={item.icon} size={20} aria-hidden={true} />
          </span>
          <p class="card-title">{item.title}</p>
          <p class="card-subtitle">{item.text}</p>
        </li>
      ))
    }
  </ul>

  <h3 class="subsection-title mb-4 mt-12" data-reveal>What I'm interested in</h3>
  <ul class="flex flex-col gap-5" data-reveal-stagger>
    {
      about.interests.map((item) => (
        <li class="flex gap-4">
          <span class="icon-tile">
            <Icon name={item.icon} size={20} aria-hidden={true} />
          </span>
          <p class="body-text">
            <span class="font-semibold text-text">{item.title}.</span> {item.text}
          </p>
        </li>
      ))
    }
  </ul>

  <div
    class="mt-12 flex flex-col items-start gap-4 rounded-xl border border-border bg-surface p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8"
    data-reveal
  >
    <div>
      <p class="subsection-title">Have a problem that fits?</p>
      <p class="body-text mt-1">Tell me what you're working on. I usually reply within a few days.</p>
    </div>
    <a href={`mailto:${profile.email}`} class="btn btn-primary shrink-0">
      <Icon name="mail" size={18} aria-hidden={true} />
      Email me
    </a>
  </div>
</section>
