---
import { about } from "../data/content";
import SectionHeader from "./SectionHeader.astro";
---

<section id="about" class="py-16 sm:py-20">
  <SectionHeader eyebrow="background" title="15+ years in software, from backend engineer to engineering leader" />

  <div class="flex max-w-[65ch] flex-col gap-4" data-reveal>
    {about.intro.map((paragraph) => <p class="body-text">{paragraph}</p>)}
  </div>
</section>
