---
import { socials, writing } from "../data/content";
import Icon from "./Icon.astro";

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
---

<section id="writing" class="py-10">
  <h2 class="section-title mb-3">Selected writing</h2>
  {
    writing.length > 0 && (
      <div class="grid gap-[10px] sm:grid-cols-2">
        {writing.map((entry) => (
          <a
            href={entry.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col rounded-lg border border-border px-4 py-[14px] transition-colors hover:border-accent"
          >
            <p class="label-text mb-1 flex items-center gap-1">
              <Icon name="medium" size={14} aria-hidden={true} />
              Medium · <time datetime={entry.published}>{formatDate(entry.published)}</time>
            </p>
            <p class="card-title mb-1">{entry.title}</p>
            <p class="card-subtitle line-clamp-3">{entry.excerpt}</p>
          </a>
        ))}
      </div>
    )
  }
  <a
    href={socials.medium}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-4 inline-block text-base text-accent underline-offset-4 hover:underline"
  >
    All articles on Medium →
  </a>
</section>
