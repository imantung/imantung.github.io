---
import { profile } from "../data/content";
import Icon from "./Icon.astro";
---

<section id="contact" class="pb-16 pt-4 sm:pb-20">
  <div
    class="flex flex-col items-start gap-4 rounded-xl border border-border bg-surface p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8"
    data-reveal
  >
    <div>
      <p class="subsection-title">Let's chat</p>
      <p class="body-text mt-1 max-w-[52ch]">
        Founders, business owners, and teams looking for a fractional engineering leader or advisor are
        welcome, and so are full-time leadership roles. Tell me where you are and what you need, or just say hi.
      </p>
    </div>
    <a href={`mailto:${profile.email}`} class="btn btn-primary shrink-0">
      <Icon name="mail" size={18} class="icon-mail mail-buzz" aria-hidden={true} />
      Say hello
    </a>
  </div>
</section>
