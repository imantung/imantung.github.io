---
import { profile } from "../data/content";
import Icon from "./Icon.astro";
---

<section id="contact" class="pb-16 pt-4 sm:pb-20">
  <div
    class="flex flex-col items-start gap-4 rounded-xl border border-border bg-surface p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8"
    data-reveal
  >
    <div>
      <p class="subsection-title">Have a problem that fits?</p>
      <p class="body-text mt-1">Tell me what you're working on. I usually reply within a few days.</p>
    </div>
    <a href={`mailto:${profile.email}`} class="btn btn-primary shrink-0">
      <Icon name="mail" size={18} aria-hidden={true} />
      Email me
    </a>
  </div>
</section>
