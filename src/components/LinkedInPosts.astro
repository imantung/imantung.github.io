---
import { linkedinPosts, socials } from "../data/content";
import Icon from "./Icon.astro";

const latest = linkedinPosts.slice(0, 4);

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  });
---

<section id="posts" class="py-10">
  <h2 class="section-title mb-3">Latest on LinkedIn</h2>
  {
    latest.length > 0 && (
      <ol class="flex flex-col border-l border-border">
        {latest.map((post) => (
          <li>
            <a
              href={post.url}
              target="_blank"
              rel="noopener noreferrer"
              class="-ml-px block border-l-2 border-transparent py-3 pl-4 transition-colors hover:border-accent"
            >
              <p class="label-text mb-1">
                <time datetime={post.published}>{formatDate(post.published)}</time>
              </p>
              <p class="card-title mb-1">{post.title}</p>
              <p class="card-subtitle">{post.excerpt}</p>
            </a>
          </li>
        ))}
      </ol>
    )
  }
  <a
    href={socials.linkedin}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-4 inline-flex items-center gap-1 text-base text-accent underline-offset-4 hover:underline"
  >
    <Icon name="linkedin" size={14} aria-hidden={true} />
    Follow on LinkedIn →
  </a>
</section>
